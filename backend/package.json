{
    "name": "sales-management-api",
    "version": "1.0.0",
    "description": "Quản lý Bán hàng & Kho hàng - Backend API",
    "private": true,
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch src/index.ts",
        "build": "tsc",
        "start": "node dist/index.js",
        "lint": "eslint \"src/**/*.ts\"",
        "test:permissions": "npm run build && node --test test/permission.utils.test.js test/shop-scope.utils.test.js",
        "test:tax": "npm run build && node --test test/tax-policy.test.js",
        "test:p0": "npm run build && node --test test/permission.utils.test.js test/shop-scope.utils.test.js test/tax-policy.test.js test/debt.utils.test.js test/sales-metric.utils.test.js test/invoice-metadata.test.js"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^5.2.1",
        "helmet": "^7.1.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "^1.11.0",
        "nodemailer": "^9.0.3",
        "pg": "^8.20.0",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^0.3.31",
        "xml2js": "^0.6.2",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.6",
        "@types/helmet": "^0.0.48",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/morgan": "^1.9.10",
        "@types/node": "^22.0.0",
        "@types/nodemailer": "^7.0.12",
        "@types/pg": "^8.20.0",
        "@types/xml2js": "^0.4.14",
        "eslint": "^10.8.0",
        "tsx": "^4.23.1",
        "typescript": "^5.7.0",
        "typescript-eslint": "^8.65.0"
    },
    "overrides": {
        "typeorm": {
            "glob": {
                "minimatch": "10.2.5"
            }
        }
    }
}
