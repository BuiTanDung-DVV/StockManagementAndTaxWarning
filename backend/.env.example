NODE_ENV=development
PORT=8080

# PostgreSQL: ưu tiên DATABASE_URL. Không commit thông tin production thật.
DATABASE_URL=
DB_HOST=localhost
DB_DATABASE=QLKH
DB_SYNC=false

# Xác thực: ba secret phải khác nhau và dài tối thiểu 32 byte trên production.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
OTP_SECRET=
JWT_EXPIRES_IN=15m
# Danh sách OAuth client ID được Google cấp, phân tách bằng dấu phẩy.
GOOGLE_CLIENT_IDS=
ALLOWED_ORIGINS=http://localhost:5000,https://smartstock-tax.vercel.app,https://stock-management-and-tax-warning.vercel.app

# OTP/SMS: dùng sandbox ở local; không bật OTP_DEBUG_RESPONSE trên production.
SMS_PROVIDER=sandbox
OTP_DEBUG_RESPONSE=false
ESMS_API_KEY=
ESMS_SECRET_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email
SMTP_USER=
SMTP_PASS=

# Cloudinary Free (không đưa API Secret vào Flutter hoặc Git)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
