{
  "version": 2,
  "buildCommand": "bash build_vercel.sh",
  "outputDirectory": "build/web",
  "installCommand": "npm install --prefix backend",
  "headers": [
    {
      "source": "/(.*\\.js)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:match*",
      "has": [
        {
          "type": "host",
          "value": "smartstock-tax.vercel.app"
        }
      ],
      "destination": "https://stock-management-and-tax-warning.vercel.app/api/:match*"
    },
    {
      "source": "/api/:match*",
      "has": [
        {
          "type": "host",
          "value": "smartstock-app.vercel.app"
        }
      ],
      "destination": "https://stock-management-and-tax-warning.vercel.app/api/:match*"
    },
    {
      "source": "/api/:match*",
      "has": [
        {
          "type": "host",
          "value": "sales-stock-tax.vercel.app"
        }
      ],
      "destination": "https://stock-management-and-tax-warning.vercel.app/api/:match*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
